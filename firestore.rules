rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'imagePath', 'socialUrl', 'externalLinks',
          'publishedAt', 'author'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000;
      allow delete: if isAdmin();
    }

    match /files/{fileId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'storagePath', 'fileName',
          'extension', 'mimeType', 'size', 'publishedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 26214400;
      allow delete: if isAdmin();
    }
  }
}
